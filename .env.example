# Copy to .env (never commit .env). Used by docker-compose.yml.

# Public host name. DNS must point at this server before first start so HTTPS can be issued.
DOMAIN=spamguard.example.com
# Contact address for Let's Encrypt expiry notices (optional).
ACME_EMAIL=

# Password for the PostgreSQL database (letters and digits only, it goes into a URL).
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Google sign-in and Gmail read access (optional; leave empty for guest-only mode) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret that signs the login cookie. Generate with:  openssl rand -hex 32
SPAMGUARD_COOKIE_SECRET=
# Set to 1 to also offer reversible Gmail label actions (needs the gmail.modify scope).
SPAMGUARD_ENABLE_GMAIL_ACTIONS=0

# Comma-separated verified Google accounts allowed to review feedback and release models.
SPAMGUARD_ADMIN_EMAILS=

# Custom IMAP servers may only be reached on these TLS ports.
SPAMGUARD_IMAP_PORTS=993
