# Copy to secrets.toml and fill in your own Google OIDC app credentials.
# Register the redirect URI in Google Cloud and enable Gmail API.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE-WITH-A-LONG-RANDOM-SECRET"
expose_tokens = ["access"]

[auth.google]
client_id = "YOUR-GOOGLE-CLIENT-ID"
client_secret = "YOUR-GOOGLE-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/gmail.readonly", prompt = "consent select_account" }

# Optional: uncomment to offer user-initiated reversible Gmail actions.
# [auth.googleactions]
# client_id = "YOUR-GOOGLE-CLIENT-ID"
# client_secret = "YOUR-GOOGLE-CLIENT-SECRET"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/gmail.modify", prompt = "consent select_account" }

[app]
admin_emails = []
